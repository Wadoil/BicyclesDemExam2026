<Window x:Class="велики.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:строматы"
        mc:Ignorable="d"
        Icon="C:\college\bicycles\BicyclesDemoExam2026-master\велики\Assets\icon.ico"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="{StaticResource MainBg}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource AdditionalBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="111"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Background="Red" Content="Exit" Name="ExitBtn" Margin="10,10,10,10" Visibility="Hidden" Click="ExitBtn_Click"/>
                <Button Background="{StaticResource Accent}" Content="Orders" Name="OrdersBtn" Margin="10,10,10,10" Visibility="Hidden" Click="OrdersBtn_Click" Grid.Column="1"/>
                <TextBlock Grid.Column="2" Name="TitleBlock" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16"/>
                <TextBlock Grid.Column="3" Name="UserTextBlock" HorizontalAlignment="Right" VerticalAlignment="Center" Height="16" Margin="10"/>
            </Grid>
        </Border>
        <Frame Grid.Row="1" Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
