<Page x:Class="велики.Pages.Catalogue"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:велики.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Catalogue">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="131*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Name="AddBtn" Margin="10" Content="Add" Background="{StaticResource Accent}" Visibility="Hidden" Click="AddBtn_Click"/>
        <ListView Name="ProductsList" Grid.Row="1" Grid.ColumnSpan="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AdditionalBg}" MouseLeftButtonUp="Edit">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="500"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{Binding image}"/>
                                        <StackPanel Grid.Column="1" Margin="5">
                                            <TextBlock Name="CategoryNameBlock" Text="{Binding CategoryName}" Foreground="White"/>
                                            <TextBlock Name="DescriptionBlock" Text="{Binding description}" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Name="ProducerBlock" Text="{Binding producer}" Foreground="White"/>
                                            <TextBlock Name="SupplierBlock" Text="{Binding supplier}" Foreground="White"/>
                                            <TextBlock Name="CostBlock" Text="{Binding cost}" Foreground="White"/>
                                            <TextBlock Name="MeasurementBlock" Text="{Binding measurement}" Foreground="White"/>
                                            <TextBlock Name="AmountBlock" Text="{Binding amount}" Foreground="White"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{StaticResource AdditionalBg}">
                                            <TextBlock Text="{Binding discount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
