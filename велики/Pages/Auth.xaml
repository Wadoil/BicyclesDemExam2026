<Page x:Class="велики.Pages.Auth"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:велики.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Auth">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Login"/>
            <TextBox Name="LoginBox"/>
            <TextBlock Text="Password"/>
            <PasswordBox Name="PasswordBox"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Name="GuestBtn" Content="Login as Guest" Background="{StaticResource Accent}" Foreground="White" Margin="5,5,5,0" Height="20" VerticalAlignment="Top" Click="GuestBtn_Click"/>
                <Button Grid.Column="1" Name="LoginBtn" Content="Login" Background="{StaticResource Accent}" Foreground="White" Margin="5" Click="LoginBtn_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
