<Page x:Class="велики.Pages.Orders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:велики.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Orders">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="131*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Name="AddBtn" Margin="10" Content="Add" Background="{StaticResource Accent}" Click="AddBtn_Click"/>
        <ListView Name="OrdersList" Grid.Row="1" Grid.ColumnSpan="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Accent}" MouseLeftButtonUp="Edit">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="5">
                                            <TextBlock Name="ArticleBlock" Text="{Binding Article}" Foreground="White"/>
                                            <TextBlock Name="StatusBlock" Text="{Binding Status}" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Name="AddressBlock" Text="{Binding Address}" Foreground="White"/>
                                            <TextBlock Name="DateOfOrderBlock" Text="{Binding DateOfOrder}" Foreground="White"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{StaticResource AdditionalBg}">
                                            <TextBlock Text="{Binding DateOfDelivery}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
