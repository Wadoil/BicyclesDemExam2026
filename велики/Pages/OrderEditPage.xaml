<Page x:Class="велики.Pages.OrderEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:велики.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderEditPage">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Code:" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Status:" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Pickup point:" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Date of Order:" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Date of Delivery:" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Text="Orderer:" Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBox Grid.Column="1" Margin="10" Name="CodeBox"/>
            <ComboBox Grid.Column="1" Margin="10" Grid.Row="1" Name="StatusBox"/>
            <ComboBox Grid.Column="1" Margin="10" Grid.Row="2" Name="PickupBox"/>
            <DatePicker Grid.Column="1" Margin="10" Grid.Row="3" Name="OrderBox"/>
            <DatePicker Grid.Column="1" Margin="10" Grid.Row="4" Name="DeliveryBox"/>
            <StackPanel Grid.Column="1" Grid.Row="5">
                <TextBlock Text="Surname:"/>
                <TextBlock Text="Name:"/>
                <TextBlock Text="Middle Name:"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="5" HorizontalAlignment="Right" Width="150">
                <TextBox Name="NameBox"/>
                <TextBox Name="SurnameBox"/>
                <TextBox Name="MiddleNameBox"/>
            </StackPanel>

            <DataGrid Grid.Row="6" Grid.ColumnSpan="2" Name="OrdersGrid" AutoGenerateColumns="True"/>
            <StackPanel Grid.Row="6" Grid.Column="2">
                <Button Content="Add" Margin="5" Background="{StaticResource AdditionalBg}" Click="AddContentBtn_Click"/>
                <Button Content="Delete" Margin="5" Background="Red" Click="DeleteContentBtn_Click"/>
                <ComboBox Margin="5" Name="ProductBox" ItemsSource="{Binding Products}"/>
                <TextBox Margin="5" Name="AmountBox"/>
            </StackPanel>

            <Button Grid.Column="0" Grid.Row="7" Margin="5" HorizontalAlignment="Left" Content=" Delete " Background="Red" Click="DeleteBtn_Click"/>
            <Button Grid.Column="1" Grid.Row="7" Margin="5" Content="Cancel" Background="{StaticResource Accent}" Click="CancelBtn_Click"/>
            <Button Grid.Column="2" Grid.Row="7" Margin="5" Content="Save" Background="{StaticResource AdditionalBg}" Click="SaveBtn_Click"/>
        </Grid>
    </ScrollViewer>
</Page>
